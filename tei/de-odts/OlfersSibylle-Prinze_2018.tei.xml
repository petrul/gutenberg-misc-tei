      <body>
         <head>Prinzeßchen im Walde</head>
         <author>Sibylle Olfers</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">odts/de-odts/OlfersSibylle-Prinze_2018.epub.odt</p>
         <head>Prinzeßchen im Walde</head>
         <pb/>
         <div type="div1">
            <head>Prinzeßchen im Walde</head>
            <pb/>
            <div type="div2">
               <head>von Sibylle v. Olfers</head>
               <p rend="justify">Stiefmütterchen</p>
               <p rend="justify">Druckermarke</p>
               <p rend="justify">Verlag von J. F. Schreiber, Eßlingen und München</p>
               <p rend="justify">Im Wald, im Wald Prinzeßchen klein</p>
               <p rend="justify">Schaut aus dem Bogenfensterlein,</p>
               <p rend="justify">Da schickt auch schon Frau Morgenwind</p>
               <p rend="justify">Taumägdelein zum Königskind.</p>
               <p rend="justify">Die Prinzeßchen klein</p>
               <p rend="justify">Taumägdelein am Bächlein klar</p>
               <p rend="justify">Glätten Prinzeßchens Sonnenhaar,</p>
               <lg>
                  <l>Bringen herbei die goldenen Schuh'</l>
                  <l>Binden das purpur'ne Kleidelein zu!</l>
               </lg>
               <lg>
                  <l>Taumägdelein glätten Prinzesschens Sonnenhaar</l>
               </lg>
               <lg>
                  <l>Moosjunge! komm' und bring' geschwind</l>
                  <l>Den Honig süß fürs Königskind!</l>
                  <l>Am Bogentor, am Baum versteckt</l>
                  <l>Ist schon der Frühstückstisch gedeckt.</l>
               </lg>
               <lg>
                  <l>der Frühstückstisch gedeckt</l>
               </lg>
               <lg>
                  <l>Auf schwarzer Tafel mit goldenem Rand</l>
                  <l>Schreibt das Prinzeßchen mit emsiger Hand.</l>
                  <l>Herr Lehrer Rabe mit seinem Buch,</l>
                  <l>Der macht das Prinzeßchen sehr weise und klug.</l>
               </lg>
               <lg>
                  <l>Herr Lehrer Rabe</l>
               </lg>
               <lg>
                  <l>Klein Rehchen komm', die Schul' ist aus,</l>
                  <l>Ihr Häschen, flink, zieht mit hinaus!</l>
                  <l>Eichhörnchen eilt und Vögelein,</l>
                  <l>Prinzeßchen will nun fröhlich sein!</l>
               </lg>
               <lg>
                  <l>Klein Rehchen komm', ihr Häschen zieht mit hinaus!</l>
               </lg>
               <lg>
                  <l>Im weichen Moos am Waldesrand —</l>
                  <l>Da ist der Pilzenkinder Land.</l>
                  <l>Die sind gar lustige kleine Gesellen</l>
                  <l>Und müssen Prinzeßlein Märchen erzählen.</l>
               </lg>
               <lg>
                  <l>Die Pilzenkinder erzählen dem Prinzeßlein Märchen</l>
               </lg>
               <lg>
                  <l>Die Sterne kommen mit lichtem Schein,</l>
                  <l>Leuchten tief in den Wald hinein,</l>
                  <l>Leuchten Prinzeßchen heim durch die Nacht,</l>
                  <l>Das hat nun genug gespielt und gelacht.</l>
               </lg>
               <lg>
                  <l>Die Sterne leuchten</l>
               </lg>
               <lg>
                  <l>Die Tierlein schlafen in Wald und Strauch,</l>
                  <l>Lieb Königskind muß schlafen auch.</l>
                  <l>Der Abendwind, der rauschet sacht.</l>
                  <l>Ein Sternlein vor dem Schlosse wacht!</l>
               </lg>
               <lg>
                  <l>Ein Sternlein vor dem Schlosse</l>
               </lg>
            </div>
         </div>
      </body>
