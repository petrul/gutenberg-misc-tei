         <head>A José Estevão</head>
         <author>Raimundo António de Bulhão Pato</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">odts/pt-odts/PatoRaimundoAntónioDeBulhão-AJos_2007.epub.odt</p>
