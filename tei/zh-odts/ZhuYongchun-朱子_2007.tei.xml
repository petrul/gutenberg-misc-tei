         <head>朱子治家格言</head>
         <author>Yongchun Zhu</author>
         <p rend="color(#000000)">{{GUTENBERG_LICENSE}}</p>
         <p rend="start color(#000000)">odts/zh-odts/ZhuYongchun-朱子_2007.epub.odt</p>
